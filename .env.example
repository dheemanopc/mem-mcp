# ---------------------------------------------------------------------------
# mem-mcp docker compose environment.
#
# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
#   cp .env.example .env
#
# Two modes:
#   LOCAL (default)  MEM_MCP_SKIP_SSM=1 → config comes entirely from this file,
#                    no AWS account needed. AWS-backed features (Cognito JWT
#                    verification, Bedrock embeddings, SES) will only work if
#                    you also provide real AWS credentials below.
#   AWS    overlay docker-compose.aws.yml: unset MEM_MCP_SKIP_SSM and let the
#                    app read /mem-mcp/* from SSM Parameter Store using the
#                    AWS credentials/role available to the container.
# ---------------------------------------------------------------------------

# === Postgres (the pgvector container) =====================================
POSTGRES_DB=mem_mcp
# Superuser for the container (only used for init + ad-hoc admin).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Application + maintenance role passwords (created by the init script).
MEM_APP_PASSWORD=change-me-app
MEM_MAINT_PASSWORD=change-me-maint

# === Config mode ===========================================================
# 1 = env-only (no SSM/AWS for config). Leave as 1 for local dev.
MEM_MCP_SKIP_SSM=1
MEM_MCP_REGION=ap-south-1
MEM_MCP_LOG_LEVEL=INFO

# === Database DSNs (point at the `postgres` compose service) ===============
# App pool (asyncpg via SQLAlchemy driver lookup) and maintenance/migrations.
MEM_MCP_DB_DSN=postgresql://mem_app:change-me-app@postgres:5432/mem_mcp
MEM_MCP_DB_MAINT_DSN=postgresql+psycopg://mem_maint:change-me-maint@postgres:5432/mem_mcp

# === Cognito / OAuth ========================================================
# Defaults below point at the `cognito-local` sidecar (jagregory/cognito-local)
# baked into docker-compose.yml — works out-of-the-box with admin@local.
# To use REAL AWS Cognito instead, replace these with your real pool/domain
# and DELETE the MEM_MCP_COGNITO_ISSUER_URL / _JWKS_URL overrides at the bottom
# of this file (so the AWS form gets constructed).
MEM_MCP_COGNITO_USER_POOL_ID=local_memmcp
MEM_MCP_COGNITO_DOMAIN=localhost:9229
MEM_MCP_WEB_CLIENT_ID=memsys-local-client
# cognito-local doesn't validate the secret for local_memmcp-style clients; any
# non-empty value is accepted. Replace with the real secret for real Cognito.
MEM_MCP_WEB_CLIENT_SECRET=local-dev-no-secret

# === URLs ==================================================================
MEM_MCP_RESOURCE_URL=http://localhost:8000
MEM_MCP_WEB_URL=http://localhost:8000

# === Secrets (generate strong random values) ===============================
MEM_MCP_INTERNAL_LAMBDA_SECRET=replace-me
MEM_MCP_WEB_SESSION_SECRET=replace-me
MEM_MCP_LINK_STATE_SECRET=replace-me

# === Email / backups =======================================================
MEM_MCP_SES_FROM=noreply@example.com
MEM_MCP_BACKUP_BUCKET=mem-mcp-backups
MEM_MCP_BACKUP_GPG_PASSPHRASE=replace-me

# === Embeddings ============================================================
# Default for the localhost stack: Ollama sidecar with bge-m3 (1024-dim,
# matches Titan v2's vector dim). Switch to "bedrock" if you have AWS creds
# and want to use Bedrock instead.
MEM_MCP_EMBEDDINGS_PROVIDER=ollama
MEM_MCP_OLLAMA_URL=http://ollama:11434
MEM_MCP_OLLAMA_EMBED_MODEL=bge-m3
# Used only when MEM_MCP_EMBEDDINGS_PROVIDER=bedrock.
MEM_MCP_BEDROCK_MODEL_ID=amazon.titan-embed-text-v2:0

# === Skill framework (optional) ============================================
# base64-encoded 32-byte AES-256 key; leave empty to disable the skill vault.
MEM_MCP_SKILL_VAULT_MASTER_KEY=
MEM_MCP_ENABLED_SKILLS=

# === Web UI ================================================================
# Where the Next.js server reaches the API (compose service name).
MEM_MCP_API_URL=http://api:8080

# === AWS credentials (only needed for live Cognito/Bedrock/SES or SSM) =====
# Prefer mounting ~/.aws or an instance role in production. For local testing
# you may set these; otherwise leave blank.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# === cognito-local sidecar overrides ========================================
# These point JWT validation at the local IdP instead of AWS. Issuer is what
# tokens carry in `iss` (browser-visible: localhost:9229). JWKS URL is where
# the api container fetches signing keys (docker-internal: cognito-local:9229).
# DELETE BOTH LINES below to use real AWS Cognito.
MEM_MCP_COGNITO_ISSUER_URL=http://localhost:9229/local_memmcp
MEM_MCP_COGNITO_JWKS_URL=http://cognito-local:9229/local_memmcp/.well-known/jwks.json

# === Bootstrap first system admin ===========================================
# Email to grant SYSTEM_ADMIN to on first service start AFTER they've signed in.
# admin@local matches the user pre-seeded in docker/cognito-local/local_memmcp.json.
MEM_MCP_BOOTSTRAP_SYSTEM_ADMIN_EMAIL=admin@local

# === Localhost — disable AWS-dependent scheduled jobs =======================
# Comma-separated list of jobs the scheduler should skip at boot. The default
# below skips jobs that call AWS Cognito ListUsers (NoCredentialsError in
# localhost mode where you have no AWS creds). Clear to re-enable them.
MEM_MCP_DISABLED_JOBS=reconcile_signups
