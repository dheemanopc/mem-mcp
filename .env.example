# ---------------------------------------------------------------------------
# mem-mcp docker compose environment.
#
# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
#   cp .env.example .env
#
# Two modes:
#   LOCAL (default)  MEM_MCP_SKIP_SSM=1 → config comes entirely from this file,
#                    no AWS account needed. AWS-backed features (Cognito JWT
#                    verification, Bedrock embeddings, SES) will only work if
#                    you also provide real AWS credentials below.
#   AWS    overlay docker-compose.aws.yml: unset MEM_MCP_SKIP_SSM and let the
#                    app read /mem-mcp/* from SSM Parameter Store using the
#                    AWS credentials/role available to the container.
# ---------------------------------------------------------------------------

# === Postgres (the pgvector container) =====================================
POSTGRES_DB=mem_mcp
# Superuser for the container (only used for init + ad-hoc admin).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Application + maintenance role passwords (created by the init script).
MEM_APP_PASSWORD=change-me-app
MEM_MAINT_PASSWORD=change-me-maint

# === Config mode ===========================================================
# 1 = env-only (no SSM/AWS for config). Leave as 1 for local dev.
MEM_MCP_SKIP_SSM=1
MEM_MCP_REGION=ap-south-1
MEM_MCP_LOG_LEVEL=INFO

# === Database DSNs (point at the `postgres` compose service) ===============
# App pool (asyncpg via SQLAlchemy driver lookup) and maintenance/migrations.
MEM_MCP_DB_DSN=postgresql://mem_app:change-me-app@postgres:5432/mem_mcp
MEM_MCP_DB_MAINT_DSN=postgresql+psycopg://mem_maint:change-me-maint@postgres:5432/mem_mcp

# === Cognito / OAuth (required fields; real values needed for live auth) ====
MEM_MCP_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
MEM_MCP_COGNITO_DOMAIN=memauth.example.com
MEM_MCP_WEB_CLIENT_ID=replace-me
MEM_MCP_WEB_CLIENT_SECRET=replace-me

# === URLs ==================================================================
MEM_MCP_RESOURCE_URL=http://localhost
MEM_MCP_WEB_URL=http://localhost

# === Secrets (generate strong random values) ===============================
MEM_MCP_INTERNAL_LAMBDA_SECRET=replace-me
MEM_MCP_WEB_SESSION_SECRET=replace-me
MEM_MCP_LINK_STATE_SECRET=replace-me

# === Email / backups =======================================================
MEM_MCP_SES_FROM=noreply@example.com
MEM_MCP_BACKUP_BUCKET=mem-mcp-backups
MEM_MCP_BACKUP_GPG_PASSPHRASE=replace-me

# === Bedrock embeddings ====================================================
MEM_MCP_BEDROCK_MODEL_ID=amazon.titan-embed-text-v2:0

# === Skill framework (optional) ============================================
# base64-encoded 32-byte AES-256 key; leave empty to disable the skill vault.
MEM_MCP_SKILL_VAULT_MASTER_KEY=
MEM_MCP_ENABLED_SKILLS=

# === Web UI ================================================================
# Where the Next.js server reaches the API (compose service name).
MEM_MCP_API_URL=http://api:8080

# === AWS credentials (only needed for live Cognito/Bedrock/SES or SSM) =====
# Prefer mounting ~/.aws or an instance role in production. For local testing
# you may set these; otherwise leave blank.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
