      "default": null,
      "title": "Supersedes"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Tags",
      "type": "array"
    },
    "team_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Team Id"
    },
    "ttl_seconds": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ttl Seconds"
