    "visibility": {
      "default": "team",
      "enum": [
        "team",
        "external",
        "public"
      ],
      "title": "Visibility",
      "type": "string"
    }
  },
  "required": [
    "content"
  ],
  "title": "MemoryWriteInput",
  "type": "object"
}
