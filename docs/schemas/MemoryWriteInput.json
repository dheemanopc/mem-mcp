            "pinned",
            "current"
          ],
          "title": "Refs Version",
          "type": "string"
        },
        "target_fragment": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Fragment"
        },
        "target_resource_type": {
          "anyOf": [
            {
              "enum": [
                "decision",
                "fact"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Resource Type"
        },
        "target_slug": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Slug"
        },
        "target_team_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Team Id"
        },
        "target_uuid": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Uuid"
        }
      },
      "required": [
        "reference_kind"
      ],
      "title": "ReferenceInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content": {
      "maxLength": 200000,
      "minLength": 1,
      "title": "Content",
      "type": "string"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
