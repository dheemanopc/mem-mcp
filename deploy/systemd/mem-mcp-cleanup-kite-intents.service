[Unit]
Description=mem-mcp kite_intents cleanup (hard-delete resolved/expired rows past 7-day grace)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=memmcp
Group=memmcp
WorkingDirectory=/opt/mem-mcp
EnvironmentFile=/etc/mem-mcp/env
ExecStart=/home/memmcp/.local/bin/poetry run python -m mem_mcp.jobs cleanup_kite_intents

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

LimitNOFILE=4096
