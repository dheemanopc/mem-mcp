[Unit]
Description=mem-mcp transient memory expiry job (task #66)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=memmcp
Group=memmcp
WorkingDirectory=/opt/mem-mcp
EnvironmentFile=/etc/mem-mcp/env
ExecStart=/home/memmcp/.local/bin/poetry run python -m mem_mcp.jobs expire_transient

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

LimitNOFILE=4096
