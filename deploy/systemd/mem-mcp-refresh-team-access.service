[Unit]
Description=mem-mcp user_effective_team_access reconciler
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=memmcp
Group=memmcp
WorkingDirectory=/opt/mem-mcp
EnvironmentFile=/etc/mem-mcp/env
ExecStart=/home/memmcp/.local/bin/poetry run python -m mem_mcp.jobs refresh_team_access

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

LimitNOFILE=4096
